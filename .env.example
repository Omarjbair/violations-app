# ===========================================
# Application
# ===========================================
NODE_ENV=
PORT=

# ===========================================
# Database
# ===========================================
MONGODB_URI=

# ===========================================
# JWT Authentication
# ===========================================
# Generate secure secrets with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# ===========================================
# Redis (cache, rate limiting, sessions)
# ===========================================
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=viol
REDIS_CACHE_TTL=300